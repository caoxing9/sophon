[Unit]
Description=Sophon relay (end-to-end encrypted sessions between a computer and its phones) and push gateway
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/local/bin/sophon-relay 0.0.0.0:8443
Restart=always
RestartSec=2
DynamicUser=yes
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
LimitNOFILE=65536
# The push gateway's own key (push.key): /var/lib/sophon-relay, kept across restarts.
StateDirectory=sophon-relay
StateDirectoryMode=0700
# The app's APNs signing key. The service runs as a user of its own that
# cannot read root's files, so systemd hands it the .p8 as a credential. The
# file has to be there (deploy.sh makes an empty one): while it is empty,
# pushes are answered NotConfigured.
LoadCredential=apns.p8:/etc/sophon-relay-apns.p8
Environment=APNS_KEY_FILE=%d/apns.p8
# APNS_KEY_ID, APNS_TEAM_ID and, if not dev.sophon.app, APNS_TOPIC.
EnvironmentFile=-/etc/sophon-relay.env

[Install]
WantedBy=multi-user.target
