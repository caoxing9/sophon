#!/bin/sh
# GitHub PR 值守：Sophon 的插件。触发它的是「GitHub」集成的「有人请求我 review」，
# 这里只管 review 完之后的事：
#
#   notify reply    开始 review 时，在飞书告诉请求你 review 的人；AI 说了结论后，
#                   在飞书通知 PR 作者（都通过「飞书」集成）
#   notify use pair 记下一个 GitHub 账号在飞书里是谁（sophon use github-pr-watch pair …）
set -eu

# Sophon 的服务不一定带着你终端里的 PATH。
gh=$(command -v gh 2>/dev/null || true)
for candidate in /opt/homebrew/bin/gh /usr/local/bin/gh "$HOME/.local/bin/gh"; do
    [ -n "$gh" ] && break
    [ -x "$candidate" ] && gh=$candidate
done
[ -n "$gh" ] || { echo "这台电脑上没有 gh：先安装 GitHub CLI 并运行 gh auth login" >&2; exit 1; }

lower() { printf '%s' "$1" | tr 'A-Z' 'a-z'; }

# 「GitHub 账号对应的飞书账号」里的每一条，一行一条：账号=邮箱，或 账号=open_id:名字。
pairs() {
    printf '%s\n' "${SOPHON_PARAM_PEOPLE:-}" | tr ',' '\n' | sed 's/^[[:space:]]*//; s/[[:space:]]*$//' | grep . || true
}

# 这个账号（小写）对应的那一条里等号后面的部分；没有就什么也不输出。
whom() {
    pairs | while IFS= read -r pair; do
        [ "$(lower "${pair%%=*}")" = "$1" ] && printf '%s\n' "${pair#*=}"
    done | tail -1
}

on() { case "$1" in yes | true | 1 | on) return 0 ;; *) return 1 ;; esac; }

# 开始 review 时：告诉请求我 review 的人，我在看了。是谁请求的，从 PR 的时间线里找
# 最近一次请求我的那条；找不到，或是我自己加的，就告诉作者。不知道对方在飞书里是谁
# 时不打扰（等 AI 说结论时会先配对）。
started() {
    on "${SOPHON_PARAM_NOTIFY_START:-yes}" || exit 0
    me=$("$gh" api user --jq .login 2>/dev/null || true)
    who=""
    [ -n "$me" ] && who=$("$gh" api --paginate "repos/${SOPHON_VAR_REPO}/issues/${SOPHON_VAR_NUMBER}/timeline" \
        --jq '.[] | select(.event == "review_requested" and .requested_reviewer.login == "'"$me"'") | .actor.login' 2>/dev/null | tail -1 || true)
    [ -n "$who" ] && [ "$(lower "$who")" != "$(lower "$me")" ] || who=${SOPHON_VAR_AUTHOR:-}
    [ -n "$who" ] || exit 0
    to=$(whom "$(lower "$who")")
    to=${to%%:*}
    case "$to" in
    ou_*) kind=--open-id ;;
    *@*) kind=--email ;;
    *)
        echo "不知道 @$who 在飞书里是谁，没有告诉对方我在 review" >&2
        exit 0
        ;;
    esac
    sophon use feishu send "$kind" "$to" --text "👀 我在 review 你的 PR #${SOPHON_VAR_NUMBER} 了（AI 助手在帮我看），有结论会告诉你
${SOPHON_VAR_URL}"
}

case "${1:-}" in
reply)
    # 接手时告诉对方我在看；AI 说了结论（sophon reply）时通知作者；结束、失败不打扰对方。
    if [ "${SOPHON_ACTION:-}" = ack ]; then
        started
        exit 0
    fi
    [ "${SOPHON_ACTION:-}" = reply ] || exit 0
    on "${SOPHON_PARAM_NOTIFY:-yes}" || exit 0
    author=${SOPHON_VAR_AUTHOR:-}
    [ -n "$author" ] || { echo "不知道这个 PR 的作者是谁，没有通知" >&2; exit 1; }
    # 作者在飞书里是谁：先看记下的对应关系（你写的，或 AI 配对后记的），
    # 没有就试 PR 提交记录里的邮箱。
    to=$(whom "$(lower "$author")")
    to=${to%%:*}
    guessed=""
    if [ -z "$to" ]; then
        to=$("$gh" api "repos/${SOPHON_VAR_REPO}/pulls/${SOPHON_VAR_NUMBER}/commits" \
            --jq '[.[] | select(.author.login == "'"$author"'") | .commit.author.email | select(test("noreply") | not)] | last // empty' 2>/dev/null || true)
        guessed=$to
    fi
    # 不知道是谁：交给对话里的 AI 去配对（提示词里写了怎么做），配好再来一次。
    unknown() {
        echo "不知道 @$author 在飞书里是谁${guessed:+（提交记录里的邮箱 $guessed 在飞书里查不到）}。先配对（sophon use github-pr-watch pair $author <飞书 open_id> \"<飞书名字>\"），再重新运行一次 sophon reply" >&2
        exit 1
    }
    case "$to" in
    '') unknown ;;
    ou_*) kind=--open-id ;;
    *@*) kind=--email ;;
    *)
        echo "「GitHub 账号对应的飞书账号」里 $author 的那一条写得不对：要邮箱，或飞书 open_id" >&2
        exit 1
        ;;
    esac
    said=$(sophon use feishu send "$kind" "$to" --text "🤖 我的 AI 助手 review 了你的 PR #${SOPHON_VAR_NUMBER}：${SOPHON_TEXT}
${SOPHON_VAR_URL}" 2>&1) || {
        # 飞书不认这个人：提交代码用的邮箱多半不是飞书账号的邮箱（企业邮箱也不行）。
        case "$said" in
        *230001* | *"invalid receive_id"*) unknown ;;
        *) printf '%s\n' "$said" >&2 ;;
        esac
        exit 1
    }
    printf '%s\n' "$said"
    ;;
use)
    # 给自动化里的 AI 用的：sophon use github-pr-watch pair <GitHub 账号> <飞书 open_id> [飞书名字]
    # 记下这个账号在飞书里是谁，写进「GitHub 账号对应的飞书账号」，以后直接通知。
    usage() { echo "用法：sophon use github-pr-watch pair <GitHub 账号> <飞书 open_id> [飞书名字]" >&2; exit 2; }
    [ "${2:-}" = pair ] || usage
    login=$(lower "${3:-}")
    id=${4:-}
    name=$(printf '%s' "${5:-}" | tr -d ',=:\n\r')
    case "$login" in '' | *[!a-z0-9-]*) usage ;; esac
    case "$id" in ou_*) ;; *) usage ;; esac
    case "$id" in *[!A-Za-z0-9_]*) usage ;; esac
    kept=$(pairs | while IFS= read -r pair; do
        [ "$(lower "${pair%%=*}")" = "$login" ] || printf '%s,' "$pair"
    done)
    plugin=$(basename "${SOPHON_PLUGIN_DATA:-github-pr-watch}")
    sophon plugin set "$plugin" "people=${kept}${login}=${id}${name:+:$name}" >/dev/null
    echo "记下了：@$login 是飞书上的 ${name:-$id}"
    ;;
*)
    echo "用法：notify reply | use pair" >&2
    exit 2
    ;;
esac
